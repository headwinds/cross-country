{
  "compilerOptions": {
    "target": "ES2020",
    "noUncheckedIndexedAccess": true, // new in TS 4.1
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["lib/*"],
      "@headwinds/cross-country": ["./lib"],
      "@headwinds/cross-country/*": ["lib/*"],
      "@headwinds/cross-country/components": ["lib/components"],
      "@headwinds/cross-country/hooks/*": ["lib/hooks/*"],
      "@headwinds/cross-country/atoms/*": ["lib/components/atoms/*"],
      "@headwinds/cross-country/molecules/*": ["lib/components/molecules/*"],
      "@headwinds/cross-country/organisms/*": ["lib/components/organisms/*"],
      "@headwinds/cross-country/templates/*": ["lib/components/templates/*"],
      "@headwinds/cross-country/pages/*": ["lib/components/pages/*"],
      "@headwinds/cross-country/services/*": ["lib/services/*"],
      "@headwinds/cross-country/models/*": ["lib/models/*"],
      "@headwinds/cross-country/types/*": ["lib/types/*"],
      "@headwinds/cross-country/utils/*": ["lib/utils/*"],
      "@headwinds/cross-country/constants/*": ["lib/constants/*"],
      "@headwinds/cross-country/styles/*": ["lib/styles/*"],
      "@headwinds/cross-country/providers/*": ["lib/providers/*"],
      "@headwinds/cross-country/test/*": ["lib/test/*"]
    },

    /* Linting 
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
    */
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist"
  },
  "include": ["lib"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
