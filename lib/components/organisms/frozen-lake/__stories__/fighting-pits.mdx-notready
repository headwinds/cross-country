import { FrozenLake } from '../frozen-lake';

# FrozenLake

The `FrozenLake` component is a simulation of the Frozen Lake environment, which is commonly used in reinforcement learning. It allows users to visualize the agent's interactions with the environment.

## Props
| Prop            | Type                | Default  | Description                                                                 |
|-----------------|---------------------|----------|-----------------------------------------------------------------------------|
| gridSize        | number              | 4        | The size of the grid for the Frozen Lake environment.                      |
| renderMode      | "2D" \| "3D"        | "2D"    | The rendering mode for the environment. Options are "2D" or "3D".         |
| showProbabilities| boolean            | false    | Whether to show the probabilities of the agent's actions.                  |
| agentPosition   | { x: number, y: number } | { x: 0, y: 0 } | The initial position of the agent in the grid.                             |
| goalPosition    | { x: number, y: number } | { x: 3, y: 3 } | The position of the goal in the grid.                                       |
| obstacles       | Array<{ x: number, y: number }> | [] | The positions of the obstacles in the grid.                                 |
| onAction        | (action: string) => void | undefined | Callback function to handle actions taken by the agent.                    |
| onReset         | () => void          | undefined | Callback function to reset the environment.                                |
| onStep          | (state: any) => void | undefined | Callback function to handle the state after each step.                     |
| onRender        | () => void          | undefined | Callback function to handle rendering the environment.                     |
| onEpisodeEnd    | () => void          | undefined | Callback function to handle the end of an episode.                         |
| onReward        | (reward: number) => void | undefined | Callback function to handle the reward received by the agent.              |
| onDone          | (done: boolean) => void | undefined | Callback function to handle the completion of an episode.                  |
| onError         | (error: string) => void | undefined | Callback function to handle errors in the environment.                     |
| onSuccess       | (success: boolean) => void | undefined | Callback function to handle the success of an action.                      |
| onFailure       | (failure: boolean) => void | undefined | Callback function to handle the failure of an action.                      |
| onEpisodeStart  | () => void          | undefined | Callback function to handle the start of an episode.                       |
| onEpisodeEnd    | () => void          | undefined | Callback function to handle the end of an episode.                         |
| onEpisodeReset  | () => void          | undefined | Callback function to handle the reset of an episode.                       |
| onEpisodeRender | () => void          | undefined | Callback function to handle the rendering of an episode.                   |
| onEpisodeStep   | () => void          | undefined | Callback function to handle the step of an episode.                        |
| onEpisodeReward | () => void          | undefined | Callback function to handle the reward of an episode.                     |
| onEpisodeDone   | () => void          | undefined | Callback function to handle the completion of an episode.                  |
| onEpisodeError  | () => void          | undefined | Callback function to handle errors in an episode.                         |
| onEpisodeSuccess| () => void          | undefined | Callback function to handle the success of an episode.                    |
| onEpisodeFailure| () => void          | undefined | Callback function to handle the failure of an episode.                    |       


<FrozenLake 
  gridSize={4} 
  renderMode="3D" 
  showProbabilities={true} 
/>